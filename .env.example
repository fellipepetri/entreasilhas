# Integração Oficial do Instagram (Meta Graph API) - Opcional
# Se fornecido, a rota /api/instagram consultará automaticamente os posts mais recentes em tempo real.
# Caso não seja fornecido, o site utiliza automaticamente o feed estruturado de alta resolução de @entreasilhas.
INSTAGRAM_ACCESS_TOKEN=

# Autenticação do Painel Administrativo (/admin-painel)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=sua_senha_segura_aqui
ADMIN_SESSION_SECRET=gerar_uma_chave_aleatoria_longa_aqui

# Cloudflare Zero Trust Tunnel Token (produção)
TUNNEL_TOKEN=

